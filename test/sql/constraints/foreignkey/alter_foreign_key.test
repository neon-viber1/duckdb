statement ok
CREATE TABLE selfref(id INTEGER PRIMARY KEY, parent INTEGER);

statement ok
INSERT INTO selfref VALUES (1, NULL), (2, 1);

statement ok
ALTER TABLE selfref ADD CONSTRAINT selflink FOREIGN KEY(parent) REFERENCES selfref(id);

statement error
DELETE FROM selfref WHERE id = 1;
----
Violates foreign key constraint

statement ok
ALTER TABLE selfref DROP CONSTRAINT selflink;

statement ok
DELETE FROM selfref WHERE id = 1;

statement ok
UPDATE selfref SET parent = NULL;

statement ok
ALTER TABLE selfref ADD CONSTRAINT selflink FOREIGN KEY(parent) REFERENCES selfref(id);

statement ok
ALTER TABLE selfref RENAME TO renamed_selfref;

statement error
INSERT INTO renamed_selfref VALUES (3, 99);
----
Violates foreign key constraint

statement ok
ALTER TABLE renamed_selfref DROP CONSTRAINT selflink;

statement ok
CREATE TABLE collision_parent(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE collision_child(id INTEGER, CONSTRAINT collision_child_id_id_fkey CHECK(id > 0));

statement ok
ALTER TABLE collision_child ADD FOREIGN KEY(id) REFERENCES collision_parent(id);

statement ok
ALTER TABLE collision_child ADD FOREIGN KEY(id) REFERENCES collision_parent(id);

query I rowsort
SELECT constraint_name FROM duckdb_constraints() WHERE table_name = 'collision_child';
----
collision_child_id_id_fkey
collision_child_id_id_fkey_2
collision_child_id_id_fkey_3

statement ok
ALTER TABLE collision_child DROP CONSTRAINT collision_child_id_id_fkey_2;

statement error
ALTER TABLE collision_child DROP CONSTRAINT collision_child_id_id_fkey;
----
Only foreign key constraints can be dropped

statement ok
