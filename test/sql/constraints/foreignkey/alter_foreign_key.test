does not exist

statement ok
DROP TABLE parent;

statement ok
CREATE SCHEMA keys;

statement ok
CREATE TABLE keys.parent(a INTEGER, b VARCHAR, PRIMARY KEY(a, b));

statement ok
CREATE TABLE keys.child(a INTEGER, b VARCHAR);

statement ok
INSERT INTO keys.parent VALUES (1, 'one'), (2, 'two');

statement ok
INSERT INTO keys.child VALUES (1, 'one'), (NULL, 'missing'), (3, NULL), (NULL, NULL);

statement ok
ALTER TABLE keys.child ADD CONSTRAINT composite FOREIGN KEY (a, b) REFERENCES keys.parent(a, b);

statement error
INSERT INTO keys.child VALUES (1, 'two');
----
Violates foreign key constraint

statement ok
ALTER TABLE keys.child DROP CONSTRAINT composite;

statement ok
INSERT INTO keys.child VALUES (1, 'two');

statement error
ALTER TABLE keys.child ADD CONSTRAINT invalid_data FOREIGN KEY (a, b) REFERENCES keys.parent(a, b);
----
Violates foreign key constraint

query I
SELECT count(*) FROM duckdb_constraints() WHERE schema_name = 'keys' AND table_name = 'child';
----
0

