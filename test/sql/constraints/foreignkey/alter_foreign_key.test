# name: test/sql/constraints/foreignkey/alter_foreign_key.test
# description: Add and drop named foreign keys on existing tables
# group: [foreignkey]

statement ok
CREATE TABLE parent(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE child(id INTEGER, other INTEGER);

statement ok
INSERT INTO parent VALUES (1), (2);

statement ok
INSERT INTO child VALUES (1, 2), (NULL, NULL);

statement ok
ALTER TABLE child ADD CONSTRAINT "Parent Link" FOREIGN KEY (id) REFERENCES parent(id);

query I
SELECT constraint_name FROM duckdb_constraints() WHERE table_name = 'child';
----
Parent Link

statement error
INSERT INTO child VALUES (3, NULL);
----
Violates foreign key constraint

statement error
UPDATE child SET id = 3 WHERE id = 1;
----
Violates foreign key constraint

statement error
DELETE FROM parent WHERE id = 1;
----
Violates foreign key constraint

statement error
UPDATE parent SET id = 3 WHERE id = 1;
----
Violates foreign key constraint

statement error
ALTER TABLE child ADD CONSTRAINT "PARENT LINK" FOREIGN KEY (other) REFERENCES parent(id);
----
Duplicate constraint name

statement ok
ALTER TABLE child ADD FOREIGN KEY (other) REFERENCES parent;

query I
SELECT count(*) FROM duckdb_constraints() WHERE table_name = 'child' AND constraint_type = 'FOREIGN KEY';
----
2

statement ok
ALTER TABLE child ADD COLUMN extra INTEGER;

statement error
ALTER TABLE child RENAME COLUMN id TO renamed;
----
foreign key constraint

statement ok
ALTER TABLE child RENAME COLUMN extra TO renamed;

query I
SELECT count(*) FROM duckdb_constraints() WHERE table_name = 'child' AND constraint_name = 'Parent Link';
----
1

